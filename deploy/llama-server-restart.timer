[Unit]
Description=Daily restart timer for llama-server

[Timer]
OnCalendar=*-*-* 03:00:00
# Spreads the actual restart over a few minutes so it doesn't land at the
# exact same instant as other cron/timer jobs on the host.
RandomizedDelaySec=5min
# If the host was asleep/off at 03:00, run the missed restart on next boot
# instead of silently skipping a whole day.
Persistent=true

[Install]
WantedBy=timers.target
