[Unit]
Description=Periodic restart of llama-server@%i (clears accumulated memory/fragmentation)
After=network.target

[Service]
Type=oneshot
# try-restart is a no-op if llama-server@%i.service isn't currently running,
# so this is safe to leave enabled even if that instance is stopped for a while.
ExecStart=/bin/systemctl try-restart llama-server@%i.service
